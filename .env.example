# Firebase AI Logic uses App Check attestation (no GEMINI_API_KEY required).
# Backend propio en Render para subidas firmadas y seguras a Cloudinary (ej: https://amdvtune-backend.onrender.com)
UPLOAD_SIGNER_URL=UPLOAD_SIGNER_URL_DEFAULT_VALUE
# Opcional (solo si usas subida directa sin backend propio):
CLOUDINARY_CLOUD_NAME=CLOUDINARY_CLOUD_NAME_DEFAULT_VALUE
CLOUDINARY_UPLOAD_PRESET=CLOUDINARY_UPLOAD_PRESET_DEFAULT_VALUE
