rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /catalog/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.auth.token.email == 'amdvtune@gmail.com' &&
                      request.auth.token.email_verified == true;
    }
  }
}
